---
layout: null
---

[
  {% assign tutoriais = site.pages | where_exp: "item", "item.path contains 'tutoriais/'" %}
  {% for tutorial in tutoriais %}
    {
      "titulo"    : "{{ tutorial.titulo }}",
      "url"      : "{{ site.baseurl }}{{ tutorial.url }}",
      "data"     : "{{ tutorial.data | date: '%d/%m/%Y' }}",
      "autoria"     : "{{ tutorial.autoria }}",
      "resumo" : "{{ tutorial.resumo | strip_html | strip_newlines | escape }}"
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]